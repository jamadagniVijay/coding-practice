  <diagram id="BrNKLxY-fva8ZxBswNji" name="ACID and CQRS">
    <mxGraphModel dx="1553" dy="704" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="xsaVMwSBwjbAe3JiTzTA-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font&gt;Heading&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; margin: 0px 0px 16px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 400; margin: 0px 0px 16px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-hveid=&quot;CAIIAAgACAwQAA&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;n6owBd awi2gc&quot;&gt;&lt;span style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;rQesXe MPyX&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-subtree=&quot;aimfl,mfl&quot;&gt;ACID&lt;/span&gt;&lt;/span&gt; and &lt;span style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;rQesXe MPyX&quot;&gt;CQRS&lt;/span&gt; are &lt;mark style=&quot;margin: 0px; border-bottom: 0px rgb(0, 29, 53);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);&quot; data-complete=&quot;true&quot; data-ved=&quot;2ahUKEwjC7Zm93fyWAxWKleEIHfdwJKAQuJAPegoIAggACAAIDBAD&quot; data-sfc-root=&quot;ep&quot; data-wiz-attrbind=&quot;class=wAe0Gc_u/cFwyDc&quot; class=&quot;MAeH&quot;&gt;two foundational concepts in system design&lt;/mark&gt;, but they operate at different levels—ACID guarantees database transaction reliability, while CQRS structures how an application handles reads and writes.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-sfc-inited=&quot;2&quot; data-complete=&quot;true&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;yhAwj&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 20px; font-weight: 600; margin: 24px 0px 12px; border-bottom: 0px rgb(0, 29, 53);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 20px; font-weight: 600; margin: 24px 0px 12px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);&quot; data-complete=&quot;true&quot; data-sfc-root=&quot;ep&quot; data-wiz-attrbind=&quot;aria-level=wAe0Gc_15/fLk2Md&quot; data-sfc-cp=&quot;&quot; data-animation-nesting=&quot;&quot; role=&quot;heading&quot; aria-level=&quot;3&quot; class=&quot;otQkpb&quot;&gt;ACID (Atomicity, Consistency, Isolation, Durability)&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-hveid=&quot;CAIIAAgACBIQAA&quot; data-ved=&quot;2ahUKEwjC7Zm93fyWAxWKleEIHfdwJKAQi4wTegoIAggACAAIEhAA&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;&quot; data-bfc=&quot;&quot;&gt;&lt;div style=&quot;margin: 12px 0px 16px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 400; margin: 12px 0px 16px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-hveid=&quot;CAIIAAgACBIQAQ&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;n6owBd awi2gc&quot;&gt;ACID is a set of properties that ensure database transactions are processed reliably&lt;/div&gt;&lt;/div&gt;&lt;ul style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; margin: 12px 0px 16px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 400; margin: 12px 0px 16px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-hveid=&quot;CAIIAAgACBQQAA&quot; data-ved=&quot;2ahUKEwjC7Zm93fyWAxWKleEIHfdwJKAQ-7AUegoIAggACAAIFBAA&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;KsbFXc U6u95&quot;&gt;&lt;div style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-hveid=&quot;CAIIAAgACBQQAQ&quot; data-ved=&quot;2ahUKEwjC7Zm93fyWAxWKleEIHfdwJKAQi4wTegoIAggACAAIFBAB&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;&quot; data-bfc=&quot;&quot;&gt;&lt;li style=&quot;margin: 0px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 400; margin: 0px 0px 12px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-hveid=&quot;CAIIAAgACBQQAg&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;Z1qcYe&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;iNqyIf&quot;&gt;&lt;span style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;rQesXe MPyX&quot;&gt;Atomicity:&lt;/span&gt; All operations in a transaction succeed, or none do (all-or-nothing).&lt;/span&gt;&lt;/li&gt;&lt;/div&gt;&lt;div style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-hveid=&quot;CAIIAAgACBQQAw&quot; data-ved=&quot;2ahUKEwjC7Zm93fyWAxWKleEIHfdwJKAQi4wTegoIAggACAAIFBAD&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;&quot; data-bfc=&quot;&quot;&gt;&lt;li style=&quot;margin: 0px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 400; margin: 0px 0px 12px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-hveid=&quot;CAIIAAgACBQQBA&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;Z1qcYe&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; data-complete=&quot;true&quot; data-sfc-root=&quot;ep&quot; data-sfc-cp=&quot;&quot; class=&quot;iNqyIf&quot;&gt;&lt;span style=&quot;font-weight: 700; margin: 0px; borde