position: absolute; top: 4px; right: 4px; display: flex; width: auto; gap: 2px; z-index: 100; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(22, 27, 34); border: 0.8px solid rgba(230, 237, 243, 0.2); border-radius: 6px; padding: 2px; opacity: 0; transition: opacity 0.2s ease-in-out;&quot;&gt;&lt;button class=&quot;pan-mode-btn&quot; title=&quot;Toggle Pan Mode&quot; aria-label=&quot;Toggle Pan Mode&quot; aria-pressed=&quot;false&quot; style=&quot;display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; color: rgb(125, 133, 144); border-width: medium; border-style: none; cursor: pointer;&quot;&gt;&lt;/button&gt;&lt;button class=&quot;zoom-out-btn&quot; title=&quot;Zoom Out&quot; aria-label=&quot;Zoom Out&quot; style=&quot;display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; color: rgb(125, 133, 144); border-width: medium; border-style: none; cursor: pointer;&quot;&gt;&lt;/button&gt;&lt;button class=&quot;zoom-in-btn&quot; title=&quot;Zoom In&quot; aria-label=&quot;Zoom In&quot; style=&quot;display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; color: rgb(125, 133, 144); border-width: medium; border-style: none; cursor: pointer;&quot;&gt;&lt;/button&gt;&lt;button class=&quot;zoom-reset-btn&quot; title=&quot;Reset Zoom&quot; aria-label=&quot;Reset Zoom&quot; style=&quot;display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; color: rgb(125, 133, 144); border-width: medium; border-style: none; cursor: pointer;&quot;&gt;&lt;/button&gt;&lt;/div&gt;&lt;div class=&quot;mermaid-resize-handle&quot; title=&quot;Drag to resize&quot; tabindex=&quot;0&quot; role=&quot;separator&quot; aria-label=&quot;Resize Mermaid Diagram&quot; aria-orientation=&quot;horizontal&quot; style=&quot;position: absolute; bottom: 0px; left: 0px; right: 0px; height: 10px; cursor: ns-resize; background: transparent; z-index: 50;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;h2 class=&quot;code-line&quot; dir=&quot;auto&quot; id=&quot;8-key-takeaways&quot; style=&quot;margin-top: 24px; margin-bottom: 16px; line-height: 1.25; padding-bottom: 0.3em; border-bottom: 1px solid rgba(255, 255, 255, 0.18); border-top-color: rgba(255, 255, 255, 0.18); border-right-color: rgba(255, 255, 255, 0.18); border-left-color: rgba(255, 255, 255, 0.18);&quot;&gt;8) Key takeaways&lt;/h2&gt;&lt;ul class=&quot;code-line&quot; dir=&quot;auto&quot; style=&quot;margin-top: 0px; margin-bottom: 0.7em;&quot;&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;A FHIR profile is a constraint layer on a base resource.&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;It improves interoperability, governance, and validation.&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;&lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(125, 133, 144); background-color: rgba(110, 118, 129, 0.4); font-size: 1em; line-height: 1.357em;&quot;&gt;StructureDefinition&lt;/code&gt; is the main artifact.&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;&lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(125, 133, 144); background-color: rgba(110, 118, 129, 0.4); font-size: 1em; line-height: 1.357em;&quot;&gt;ValueSet&lt;/code&gt; and &lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(125, 133, 144); background-color: rgba(110, 118, 129, 0.4); font-size: 1em; line-height: 1.357em;&quot;&gt;CodeSystem&lt;/code&gt; support constrained coding.&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;In IRIS, profile validation is version-aware and depends on the FHIR validation service.&lt;/li&gt;&lt;/ul&gt;&lt;h2 class=&quot;code-line&quot; dir=&quot;auto&quot; id=&quot;9-quick-checklist&quot; style=&quot;margin-top: 24px; margin-bottom: 16px; line-height: 1.25; padding-bottom: 0.3em; border-bottom: 1px solid rgba(255, 255, 255, 0.18); border-top-color: rgba(255, 255, 255, 0.18); border-right-color: rgba(255, 255, 255, 0.18); border-left-color: rgba(255, 255, 255, 0.18);&quot;&gt;9) Quick checklist&lt;/h2&gt;&lt;ul class=&quot;code-line&quot; dir=&quot;auto&quot; style=&quot;margin-top: 0px; margin-bottom: 0.7em;&quot;&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;Do I need a narrower set of rules than the base FHIR standard?&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;Is the profile tied to a specific workflow or local code list?&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;Have I defined &lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(125, 133, 144); background-color: rgba(110, 118, 129, 0.4); font-size: 1em; line-height: 1.357em;&quot;&gt;url&lt;/code&gt;, &lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(125, 133, 144); background-color: rgba(110, 118, 129, 0.4); font-size: 1em; line-height: 1.357em;&quot;&gt;baseDefinition&lt;/code&gt;, and &lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(125, 133, 144); background-color: rgba(110, 118, 129, 0.4); font-size: 1em; line-height: 1.357em;&quot;&gt;derivation&lt;/code&gt;?&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;Is the validation URL versioned for IRIS?&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;Am I validating with &lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(125, 133, 144); background-color: rgba(110, 118, 129, 0.4); font-size: 1em; line-height: 1.357em;&quot;&gt;meta.profile&lt;/code&gt; or &lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(125, 133, 144); background-color: rgba(110, 118, 129, 0.4); font-size: 1em; line-height: 1.357em;&quot;&gt;$validate&lt;/code&gt;?&lt;/li&gt;&lt;/ul&gt;&lt;p class=&quot;code-line code-active-line&quot; dir=&quot;auto&quot; style=&quot;margin-top: 0px; margin-bottom: 16px;&quot;&gt;This is enough to start implementing and reasoning about FHIR profiles in IRIS without getting lost in the full specification.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div class=&quot;code-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="3940" width="800" x="30" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="kxEgq4joCyhG4ziykJnL-0" parent="qkyLPPaMuicFOam1TiuT-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
                    <mxGeometry height="520" width="438.75" x="240" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="kxEgq4joCyhG4ziykJnL-1" parent="qkyLPPaMuicFOam1TiuT-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
                    <mxGeometry height="80" width="1217.97" x="30" y="3770" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="RGHEiJsT-3KPwlvVbP8y" name="HL7 → FHIR">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="9IMlSXolNBSxa04BiI-x-0"/>
                <mxCell id="9IMlSXolNBSxa04BiI-x-1" parent="9IMlSXolNBSxa04BiI-x-0"/>
                <mxCell id="PtFToEoLPbUmFmE4jFXk-1" parent="9IMlSXolNBSxa04BiI-x-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
                    <mxGeometry height="650" width="1065.74" x="30" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="bQ1b-3z8ya2D_cAzbd05-0" parent="9IMlSXolNBSxa04BiI-x-1" style="text;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;p dir=&quot;ltr&quot;&gt;They’re mostly &lt;strong&gt;not&lt;/strong&gt; related — and knowing that is itself an interview point. They’re two different standards families solving two different problems.&lt;/p&gt;&lt;br&gt;&lt;div dir=&quot;ltr&quot;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th scope=&quot;col&quot; style=&quot;&quot;&gt;&lt;/th&gt;&lt;th scope=&quot;col&quot; style=&quot;&quot;&gt;&lt;strong&gt;X12 EDI&lt;/strong&gt; (270/837/835)&lt;/th&gt;&lt;th scope=&quot;col&quot; style=&quot;&quot;&gt;&lt;strong&gt;HL7 v2&lt;/strong&gt; (ADT/ORM/ORU)&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Domain&lt;/td&gt;&lt;td&gt;Administrative &amp;amp; financial&lt;/td&gt;&lt;td&gt;Clinical&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Who talks&lt;/td&gt;&lt;td&gt;Provider ↔ payer/clearinghouse&lt;/td&gt;&lt;td&gt;Systems inside or between provider orgs (EHR ↔ lab ↔ radiology)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Standards body&lt;/td&gt;&lt;td&gt;ASC X12 (ANSI)&lt;/td&gt;&lt;td&gt;HL7 International&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Carries&lt;/td&gt;&lt;td&gt;Coverage, claims, payment&lt;/td&gt;&lt;td&gt;Admissions, orders, results&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Transport&lt;/td&gt;&lt;td&gt;SFTP, AS2, web services&lt;/td&gt;&lt;td&gt;MLLP over TCP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ack&lt;/td&gt;&lt;td&gt;TA1 / 999&lt;/td&gt;&lt;td&gt;ACK message (MSA segment)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Mandated?&lt;/td&gt;&lt;td&gt;&lt;strong&gt;Yes&lt;/strong&gt; — HIPAA requires X12 for these transactions&lt;/td&gt;&lt;td&gt;No, conventional&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;br&gt;&lt;p dir=&quot;ltr&quot;&gt;Rough mental model: &lt;strong&gt;HL7 v2 moves the patient’s clinical story; X12 moves the money.&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;Where they genuinely touch — four points worth naming&lt;/strong&gt;&lt;/p&gt;&lt;ol dir=&quot;ltr&quot;&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;Registration → eligibility.&lt;/strong&gt; An ADT^A04 (register) or A08 (update) carries &lt;code dir=&quot;ltr&quot;&gt;IN1&lt;/code&gt;/&lt;code dir=&quot;ltr&quot;&gt;IN2&lt;/code&gt; insurance segments. That’s where payer, member ID and group number enter the clinical system. Your 270 is assembled from &lt;code dir=&quot;ltr&quot;&gt;PID&lt;/code&gt; (demographics) plus &lt;code dir=&quot;ltr&quot;&gt;IN1&lt;/code&gt; (coverage) — so the ADT feed is literally the upstream source of the eligibility inquiry. This is the connection most directly relevant to your work.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;Charges → claim.&lt;/strong&gt; A &lt;code dir=&quot;ltr&quot;&gt;DFT^P03&lt;/code&gt; (detail financial transaction) in v2 carries charge data that feeds the 837.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;Acknowledgement thinking is identical.&lt;/strong&gt; v2’s ACK with its &lt;code dir=&quot;ltr&quot;&gt;MSA&lt;/code&gt; segment is the same concept as 999 — syntax-level, separate from the business response. &lt;code dir=&quot;ltr&quot;&gt;MSA-1&lt;/code&gt; of &lt;code dir=&quot;ltr&quot;&gt;AA&lt;/code&gt;/&lt;code dir=&quot;ltr&quot;&gt;AE&lt;/code&gt;/&lt;code dir=&quot;ltr&quot;&gt;AR&lt;/code&gt; maps conceptually to the 999’s accept/reject. Same design pattern, different standard.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;Both are segment-and-delimiter formats&lt;/strong&gt; with pipe-ish syntax, positional fields, and companion guides that make every implementation differ. Your parsing instincts transfer directly.&lt;/li&gt;&lt;br&gt;&lt;/ol&gt;&lt;br&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;The FHIR bridge — this is the answer that lands&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;p dir=&quot;ltr&quot;&gt;FHIR’s significance is that it covers &lt;strong&gt;both worlds in one resource model&lt;/strong&gt;, which neither predecessor did:&lt;/p&gt;&lt;br&gt;&lt;div dir=&quot;ltr&quot;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th scope=&quot;col&quot; style=&quot;&quot;&gt;Source&lt;/th&gt;&lt;th scope=&quot;col&quot; style=&quot;&quot;&gt;FHIR resource&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code dir=&quot;ltr&quot;&gt;PID&lt;/code&gt; segment&lt;/td&gt;&lt;td&gt;&lt;code dir=&quot;ltr&quot;&gt;Patient&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code dir=&quot;ltr&quot;&gt;OBX&lt;/code&gt; (result)&lt;/td&gt;&lt;td&gt;&lt;code dir=&quot;ltr&quot;&gt;Observation&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code dir=&quot;ltr&quot;&gt;ORM&lt;/code&gt; (order)&lt;/td&gt;&lt;td&gt;&lt;code dir=&quot;ltr&quot;&gt;ServiceRequest&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ADT encounter&lt;/td&gt;&lt;td&gt;&lt;code dir=&quot;ltr&quot;&gt;Encounter&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code dir=&quot;ltr&quot;&gt;IN1&lt;/code&gt; / coverage&lt;/td&gt;&lt;td&gt;&lt;code dir=&quot;ltr&quot;&gt;Coverage&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;270 / 271&lt;/td&gt;&lt;td&gt;&lt;code dir=&quot;ltr&quot;&gt;CoverageEligibilityRequest&lt;/code&gt; / &lt;code dir=&quot;ltr&quot;&gt;CoverageEligibilityResponse&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span dir=&quot;ltr&quot;&gt;837&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;code dir=&quot;ltr&quot;&gt;Claim&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span dir=&quot;ltr&quot;&gt;835&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;code dir=&quot;ltr&quot;&gt;ClaimResponse&lt;/code&gt; / &lt;code dir=&quot;ltr&quot;&gt;ExplanationOfBenefit&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;br&gt;&lt;p dir=&quot;ltr&quot;&gt;So the sentence to have ready:&lt;/p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;“Today eligibility runs on X12 and the clinical feeds on HL7 v2 — two separate stacks with separate transports and separate ack models. In FHIR both collapse into one resource graph: the same Patient resource that anchors Observations also anchors Coverage and CoverageEligibilityResponse. That’s the consolidation worth building toward.”&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;One nuance that shows real judgement:&lt;/strong&gt; don’t claim FHIR replaces X12 imminently. HIPAA &lt;em&gt;mandates&lt;/em&gt; X12 for the named transactions, so the financial side isn’t going anywhere soon. The realistic position is FHIR as the API and integration layer over an X12 core — which is exactly what CMS’s Da Vinci work (PAS, CRD, DTR) is doing. Saying that distinguishes you from someone who’s read a FHIR blog post.&lt;/p&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="1010" width="850" x="40" y="690" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="ptX0FJdKg7OO8p43_Fuy" name="RCM Flow">
        <mxGraphModel dx="1386" dy="1066" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="o7SwSCE4D-OOq4p_9lwP-0"/>
                <mxCell id="o7SwSCE4D-OOq4p_9lwP-1" parent="o7SwSCE4D-OOq4p_9lwP-0"/>
                <mxCell id="6EiR9wxCgyTmm7lwHbLI-2" parent="o7SwSCE4D-OOq4p_9lwP-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
                    <mxGeometry height="1230" width="1036.52" x="690" y="240" as="geometry"/>
                </mxCell>
                <mxCell id="UhrB44ZTxXkmQJrzUi63-1" parent="o7SwSCE4D-OOq4p_9lwP-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 20px;&quot;&gt;athenaIDX -&amp;gt; RCM parts&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;• Step 01: Patient Registration - worked in this area&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;• Step 02: Scheduling -&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;• Step 03: Patient Eligibility and Benefits Verification&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;• Step 04: Prior Authorization&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&lt;/span&gt;Patient visits / treatment&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;• Step 05: Medical Coding&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt